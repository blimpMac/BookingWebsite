# Vercel environment variables — do not commit live credentials.
ADMIN_USERNAME=Greenlight
ADMIN_PASSWORD_SCRYPT= # 16-byte salt hex:64-byte scrypt derived key hex
SESSION_SECRET= # random 64-char hex token
# Only configure after creating a dedicated Supabase project (never reuse RFP credentials).
SUPABASE_URL=
SUPABASE_SECRET_KEY= # Recommended: sb_secret_... from the Greenlight project API keys (server only)
# For legacy projects only (do not set both unless rotating):
# SUPABASE_SERVICE_ROLE_KEY=
# Required safety check: only connect if the URL matches this dedicated project ref.
BOOKING_SUPABASE_PROJECT_REF=
